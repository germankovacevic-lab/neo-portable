# Copy to .env and fill in. Each cloud brain reads its own key from the env.
# The Ollama brain runs fully local and needs no key.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# --- Remote control channel (only for --daemon / --remote-send) ---
RELAY_URL=https://neo-portable-relay.<subdomain>.workers.dev
AGENT_TOKEN=...        # daemon side (poll + post result)
OPERATOR_TOKEN=...     # operator side (enqueue + read result)
# POLL_INTERVAL_MS=2500
